    <!-- Game rule HTML -->
    <string name="game_rule"><![CDATA[<h3>Game Rules</h3><br><b>How to Play:</b><br>• Tap two identical animals to eliminate them<br>• Connection path allows at most <b>2 turns</b> (i.e., at most 3 straight segments)<br>• Path cannot pass through other unmatched animal tiles<br>• Path can go along the board outer border<br><br><b>Difficulty:</b><br>• <font color="#4CAF50">Easy:</font> 10 animal types, easy to distinguish<br>• <font color="#FFC107">Medium:</font> 15 animal types, moderate difficulty<br>• <font color="#F44336">Hard:</font> 25 animal types, very challenging<br><br><b>Win Condition:</b><br>Clear all animal pairs within the time limit<br><br><b>Lose Conditions:</b><br>• Time runs out<br>• No remaining linkable pairs]]></string>
