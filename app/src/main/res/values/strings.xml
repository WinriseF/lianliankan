    <!-- Help -->
    <string name="help_title">How to Play</string>
    <string name="help_subtitle">Tap two matching animals to connect them. Paths can turn at most 2 times.</string>
    <string name="connection_types">Connection Types</string>
    <string name="rule_0_turn">0 turns: Same row or column, no unmatched tiles in between.</string>
    <string name="rule_1_turn">1 turn: L-shaped path, the corner must be empty.</string>
    <string name="rule_2_turn">2 turns: Z-shaped or U-shaped paths allowed.</string>
    <string name="difficulty_strategy">Difficulty &amp; Strategy</string>
    <string name="difficulty_strategy_desc">Easy uses 10 animal types for beginners; Medium uses 15; Hard uses 25. Prioritize clearing edges and directly connectable tiles to open up paths.</string>
    <string name="game_rules_detail">Tap two identical animals to attempt a connection. The path extends only horizontally or vertically, with at most 2 turns, and cannot pass through unmatched tiles. Clear all 36 pairs within 2 minutes to win; time running out or no linkable pairs means game over.</string>

